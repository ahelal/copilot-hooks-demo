{
  "hooks": {
    "SessionStart": [
      { "type": "command", "command": "node .github/hooks/scripts/log-event.mjs SessionStart", "timeout": 5 }
    ],
    "UserPromptSubmit": [
      { "type": "command", "command": "node .github/hooks/scripts/log-event.mjs UserPromptSubmit", "timeout": 5 }
    ],
    "PreToolUse": [
      { "type": "command", "command": "node .github/hooks/scripts/log-event.mjs PreToolUse", "timeout": 5 },
      { "type": "command", "command": "node .github/hooks/scripts/pre-tool-policy.mjs", "timeout": 5 }
    ],
    "PostToolUse": [
      { "type": "command", "command": "node .github/hooks/scripts/log-event.mjs PostToolUse", "timeout": 5 }
    ],
    "Stop": [
      { "type": "command", "command": "node .github/hooks/scripts/log-event.mjs Stop", "timeout": 5 },
      { "type": "command", "command": "node .github/hooks/scripts/stop-gate.mjs", "timeout": 120 }
    ]
  }
}
